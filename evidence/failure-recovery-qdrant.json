{
  "scenario": "Qdrant temporary stop and recovery on basic Compose stack",
  "scope": "lab28-platform/qdrant only; no docker compose down, no volume removal",
  "commands": {
    "inject": "docker compose --env-file ports.template stop qdrant",
    "recover": "docker compose --env-file ports.template start qdrant"
  },
  "before": {
    "timestamp_utc": "2026-09-03T17:24:19.349356+00:00",
    "qdrant": {
      "http_status": 200,
      "status": "ok",
      "points_count": 13
    },
    "gateway_ready": {
      "http_status": 200,
      "status": "degraded"
    }
  },
  "failure": {
    "timestamp_utc": "2026-09-03T17:25:27.837080+00:00",
    "qdrant_direct": {
      "http_status": null,
      "error": "ConnectTimeout"
    },
    "gateway_ready": {
      "http_status": 503,
      "status": "not_ready",
      "qdrant": {
        "ready": false,
        "detail": "0 points; ResponseHandlingException: [Errno -2] Name or service not known"
      }
    }
  },
  "recovery": {
    "timestamp_utc": "2026-09-03T17:26:01.920117+00:00",
    "qdrant": {
      "http_status": 200,
      "status": "ok",
      "points_count": 13
    },
    "gateway_ready": {
      "http_status": 200,
      "status": "degraded",
      "qdrant_ready": true,
      "remaining_degraded_reason": "vllm unreachable: ConnectError (optional dependency)"
    }
  },
  "no_data_loss_proof": {
